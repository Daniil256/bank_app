### ============================================
# @name clientLogin
POST {{baseUrl}}/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{clientEmail}}",
  "password": "{{clientPassword}}"
}


### ============================================
# @name officerLogin
POST {{baseUrl}}/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{officerEmail}}",
  "password": "{{officerPassword}}"
}


### ONLY CLIENT
POST {{baseUrl}}/v1/kyc/applications
Accept: {{contentType}}
Authorization: Bearer {{clientAccessToken}}
#работает нестабльно

### ONLY OFFICER/ADMIN
GET {{baseUrl}}/v1/kyc/applications
Accept: {{contentType}}
Authorization: Bearer {{officerAccessToken}}


### ONLY OFFICER/ADMIN
GET {{baseUrl}}/v1/kyc/applications/{{application_id}}
Accept: {{contentType}}
Authorization: Bearer {{officerAccessToken}}


### ONLY CLIENT
GET {{baseUrl}}/v1/kyc/applications/me
Accept: {{contentType}}
Authorization: Bearer {{clientAccessToken}}


### ONLY OFFICER/ADMIN
POST {{baseUrl}}/v1/kyc/applications/{{application_id_r}}/claim
Accept: {{contentType}}
Authorization: Bearer {{officerAccessToken}}


### ONLY OFFICER/ADMIN
POST {{baseUrl}}/v1/kyc/applications/{{application_id}}/approve
Accept: {{contentType}}
Authorization: Bearer {{officerAccessToken}}


### Reject заявки
POST {{baseUrl}}/v1/kyc/applications/{{application_id_r}}/reject
Content-Type: application/json
Authorization: Bearer {{officerAccessToken}}

{
  "reason": "Photo is unclear, please re-upload a better quality selfie"
}