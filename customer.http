### ============================================
### 0. Подготовка: логин CLIENT
### ============================================

# @name clientLogin
POST {{baseUrl}}/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{clientEmail}}",
  "password": "{{clientPassword}}"
}

###
@clientToken = {{clientLogin.response.body.$.access_token}}


### ============================================
### 0. Подготовка: логин OFFICER
### ============================================

# @name officerLogin
POST {{baseUrl}}/v1/auth/login
Content-Type: {{contentType}}

{
  "email": "{{officerEmail}}",
  "password": "{{officerPassword}}"
}

###
@officerToken = {{officerLogin.response.body.$.access_token}}


### ============================================
### 1. GetCustomer — GET /v1/customers/{customer_id}
###    CLIENT смотрит свой профиль
### ============================================

GET {{baseUrl}}/v1/customers/{{customerId}}
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}
### Ожидаемый ответ 200:
# {
#   "id": "...",
#   "userId": "...",
#   "firstName": "Daniil",
#   "lastName": "Ivanov",
#   "birthDate": "1990-01-01",
#   "address": "Tbilisi, ...",
#   "phone": "+995...",
#   "citizenship": "GE",
#   "status": "PROFILE_FILLED",
#   "createdAt": "...",
#   "updatedAt": "..."
# }


### ============================================
### 2. UpdateProfile — PATCH /v1/customers/me
###    CLIENT редактирует свой профиль
### ============================================

PATCH {{baseUrl}}/v1/customers/me
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "firstName": "Daniil",
  "lastName": "Ivanov",
  "birthDate": "1990-01-01",
  "address": "Tbilisi, Rustaveli Ave 1",
  "phone": "+995555123456",
  "citizenship": "GE"
}

### Ожидаемый ответ 200:
# {
#   "id": "...",
#   "userId": "...",
#   "firstName": "Daniil",
#   "lastName": "Ivanov",
#   "birthDate": "1990-01-01",
#   "address": "Tbilisi, Rustaveli Ave 1",
#   "phone": "+995555123456",
#   "citizenship": "GE",
#   "status": "PROFILE_FILLED",
#   ...
# }
#
# Ошибки:
# 403 PermissionDenied — роль не CLIENT
# 412 FailedPrecondition — статус ON_KYC или ACTIVE
# 400 InvalidArgument — пустые firstName/lastName, неверная дата


### ============================================
### 3. GetCustomerStatus — GET /v1/customers/{customer_id}/status
###    Любой авторизованный смотрит статус
### ============================================

GET {{baseUrl}}/v1/customers/{{customerId}}/status
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}
### Ожидаемый ответ 200:
# {
#   "customerId": "...",
#   "status": "PROFILE_FILLED"
# }


### ============================================
### 4. ListCustomers — GET /v1/customers
###    Только OFFICER/ADMIN. Фильтры + пагинация
### ============================================

GET {{baseUrl}}/v1/customers?status=ON_KYC&pageSize=20
Accept: {{contentType}}
Authorization: Bearer {{accessToken}}

### Ожидаемый ответ 200:
# {
#   "customers": [
#     {
#       "id": "...",
#       "userId": "...",
#       "firstName": "...",
#       "lastName": "...",
#       "status": "ON_KYC",
#       ...
#     }
#   ],
#   "nextPageToken": "..."
# }
#
# Ошибки:
# 403 PermissionDenied — роль не OFFICER/ADMIN