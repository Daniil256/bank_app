### ============================================
### 1. InitUpload — PASSPORT (успех)
### ============================================

# @name initPassport
POST {{baseUrl}}/v1/documents/init-upload
Content-Type: {{contentType}}
Authorization: Bearer {{clientAccessToken}}

{
  "doc_type": "PASSPORT"
}

### Ожидаемый ответ 200:
# {
#   "document_id": "550e8400-...",
#   "upload_url": "http://localhost:9000/documents/customers/.../PASSPORT/...?X-Amz-Algorithm=...",
#   "object_key": "customers/.../PASSPORT/..."
# }


